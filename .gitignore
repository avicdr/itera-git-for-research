# ==================================================
# ResearchGit .gitignore
# ==================================================

# --------------------
# macOS
# --------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# --------------------
# Environment / Secrets
# --------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example

# --------------------
# Python
# --------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

backend/venv/
backend/.venv/

# Python packaging
*.egg-info/
.eggs/
dist/
build/
develop-eggs/
downloads/
eggs/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# mypy / ruff
.mypy_cache/
.ruff_cache/
.pyre/

# --------------------
# ResearchGit Backend
# --------------------

# SQLite databases
*.db
*.sqlite
*.sqlite3

backend/researchgit.db

# Uploaded research artifacts / generated files
backend/storage/
storage/

# Temporary files
tmp/
temp/
*.tmp

# Logs
*.log
logs/

# --------------------
# Node / Next.js
# --------------------
node_modules/
web/node_modules/

.next/
web/.next/

out/
web/out/

.vercel/

# Build output
dist/
build/

# Next.js
.next
out

# TypeScript
*.tsbuildinfo

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Package manager caches
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# --------------------
# IDE / Editors
# --------------------

# VS Code
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# --------------------
# Docker
# --------------------
docker-compose.override.yml

# --------------------
# Local AI / RAG generated data
# --------------------
embeddings/
vector_store/
vectorstore/
chroma/
chroma_db/
.faiss/
*.faiss

# --------------------
# Local development
# --------------------
.local/
.cache/
.cache-loader/

# --------------------
# Misc
# --------------------
Thumbs.db
Desktop.ini